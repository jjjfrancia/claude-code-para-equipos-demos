{
  "hooks": {
    "PreToolUse": [{
      "matcher": "Edit|Write",
      "hooks": [{
        "type": "command",
        "command": "python .claude/hooks/protect_paths.py"
      }]
    }],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "python .claude/hooks/verify_done.py"
      }]
    }]
  }
}
